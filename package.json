{
  "name": "@libs/observability",
  "version": "0.0.1",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@libs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bootstrap": {
      "@libs/source": "./src/bootstrap.ts",
      "types": "./dist/bootstrap.d.ts",
      "default": "./dist/bootstrap.js"
    }
  },
  "typesVersions": {
    "*": {
      "bootstrap": [
        "./dist/bootstrap.d.ts"
      ],
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.lib.json",
    "clean": "tsc -b tsconfig.lib.json --clean",
    "pack:build": "tsc -p tsconfig.pack.json"
  },
  "peerDependencies": {
    "@nestjs/axios": "^3.1.3 || ^4.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@opentelemetry/api": "^1.9.1",
    "axios": "^1.6.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-express": "^0.69.0",
    "@opentelemetry/instrumentation-kafkajs": "^0.30.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.67.0",
    "@opentelemetry/instrumentation-typeorm": "^0.21.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "dotenv": "^17.2.1",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/axios": "^3.1.3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@types/node": "20.19.9",
    "axios": "^1.6.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "typescript": "~5.8.2"
  }
}
