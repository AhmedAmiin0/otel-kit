{
  "name": "otel-kit",
  "version": "0.1.0",
  "description": "OpenTelemetry setup that configures itself from the packages your app already has, with pluggable exporters and an optional NestJS adapter.",
  "keywords": [
    "opentelemetry",
    "otel",
    "observability",
    "tracing",
    "metrics",
    "logging",
    "instrumentation",
    "prometheus",
    "nestjs",
    "pino"
  ],
  "license": "MIT",
  "author": "Ahmed Amin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmedAmiin0/otel-kit.git"
  },
  "homepage": "https://github.com/AhmedAmiin0/otel-kit#readme",
  "bugs": {
    "url": "https://github.com/AhmedAmiin0/otel-kit/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "./dist/register.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.ts",
      "default": "./dist/nestjs/index.js"
    },
    "./pino": {
      "types": "./dist/pino/index.d.ts",
      "default": "./dist/pino/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core/index.d.ts"
      ],
      "node": [
        "./dist/node/index.d.ts"
      ],
      "nestjs": [
        "./dist/nestjs/index.d.ts"
      ],
      "pino": [
        "./dist/pino/index.d.ts"
      ],
      "register": [
        "./dist/register.d.ts"
      ],
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.lib.json",
    "clean": "tsc -b tsconfig.lib.json --clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc -b tsconfig.lib.json --dry",
    "build:clean": "tsc -b tsconfig.lib.json --force",
    "prepublishOnly": "npm run build:clean && npm test"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@nestjs/axios": "^3.1.3 || ^4.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-prometheus": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "axios": "^1.6.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/sdk-node": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@opentelemetry/sdk-logs": {
      "optional": true
    },
    "@opentelemetry/sdk-metrics": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "@opentelemetry/semantic-conventions": {
      "optional": true
    },
    "@opentelemetry/core": {
      "optional": true
    },
    "@opentelemetry/instrumentation": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-grpc": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-proto": {
      "optional": true
    },
    "@opentelemetry/exporter-metrics-otlp-http": {
      "optional": true
    },
    "@opentelemetry/exporter-logs-otlp-http": {
      "optional": true
    },
    "@opentelemetry/exporter-prometheus": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@nestjs/axios": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "axios": {
      "optional": true
    },
    "nestjs-pino": {
      "optional": true
    },
    "pino": {
      "optional": true
    },
    "pino-http": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/testing": "^11.1.28",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@types/jest": "^29.5.14",
    "@types/node": "20.19.9",
    "@types/supertest": "^7.2.1",
    "axios": "^1.6.0",
    "jest": "^29.7.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "~5.8.2"
  }
}
